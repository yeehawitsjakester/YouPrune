{
  "manifest_version": 3,
  "name": "YouPrune",
  "version": "0.1.0",
  "description": "Prune your YouTube feed: enforce Not-Interested / Don't-recommend signals and hide channels & slop that YouTube ignores.",
  "permissions": ["storage", "contextMenus"],
  "host_permissions": ["*://*.youtube.com/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "exclude_matches": ["*://music.youtube.com/*"],
      "js": ["src/common.js", "src/content.js"],
      "css": ["src/hide.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "YouPrune"
  },
  "options_page": "src/options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
